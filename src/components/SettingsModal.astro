---
// Settings and Station Configuration Modal Component
---

<div
  id="settingsModal"
  class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 hidden transition-opacity"
  role="dialog"
  aria-modal="true"
  aria-labelledby="settingsModalTitle"
>
  <div
    class="bg-brand-surface border border-brand-surfaceBorder w-full max-w-md rounded-t-3xl sm:rounded-2xl max-h-[88dvh] overflow-y-auto overscroll-contain flex flex-col p-4 sm:p-5 shadow-2xl space-y-3.5 animate-in slide-in-from-bottom duration-200"
    style="padding-bottom: max(1.25rem, env(safe-area-inset-bottom)); -webkit-overflow-scrolling: touch;"
  >
    <div class="flex justify-between items-center pb-2 border-b border-zinc-800 shrink-0">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-brand-amber"></span>
        <h2 id="settingsModalTitle" class="font-display uppercase text-lg text-white font-bold tracking-wide">
          Station &amp; Einstellungen
        </h2>
      </div>
      <button
        id="closeSettingsBtn"
        type="button"
        aria-label="Einstellungen schließen"
        class="text-zinc-400 hover:text-white p-1 rounded-lg text-xl leading-none transition cursor-pointer"
      >
        &times;
      </button>
    </div>

    <!-- Station Identifier Input -->
    <div>
      <label for="stationInput" class="block text-xs uppercase font-mono text-zinc-300 font-semibold mb-1">
        Tür / Name des Zählers
      </label>
      <input
        id="stationInput"
        type="text"
        placeholder="z.B. Tür 1 (Haupteingang) oder Alex"
        class="w-full bg-black/60 border border-zinc-700/80 text-white px-3 py-2 rounded-xl text-sm focus:border-brand-orange focus:ring-1 focus:ring-brand-orange outline-none transition font-sans"
      />
      <p class="text-[10px] sm:text-[11px] text-zinc-500 mt-1 leading-snug">
        Wird im E-Mail-Betreff und Bericht vermerkt, wenn mehrere Mitarbeiter zählen.
      </p>
    </div>

    <!-- Recipient Email Input -->
    <div>
      <label for="recipientEmailInput" class="block text-xs uppercase font-mono text-zinc-300 font-semibold mb-1">
        Standard Empfänger E-Mail
      </label>
      <input
        id="recipientEmailInput"
        type="email"
        placeholder="z.B. orga@sonnenraum.berlin"
        class="w-full bg-black/60 border border-zinc-700/80 text-white px-3 py-2 rounded-xl text-sm focus:border-brand-orange focus:ring-1 focus:ring-brand-orange outline-none transition font-sans"
      />
    </div>

    <!-- Target Goal Input -->
    <div>
      <label for="targetInput" class="block text-xs uppercase font-mono text-zinc-300 font-semibold mb-1">
        Mindestziel (Default: 300 Gäste)
      </label>
      <input
        id="targetInput"
        type="number"
        min="10"
        step="10"
        value="300"
        class="w-full bg-black/60 border border-zinc-700/80 text-white px-3 py-2 rounded-xl text-sm focus:border-brand-orange focus:ring-1 focus:ring-brand-orange outline-none transition font-mono"
      />
    </div>

    <!-- Action Buttons -->
    <div class="pt-2.5 border-t border-zinc-800 flex flex-col gap-2 shrink-0">
      <button
        id="saveSettingsBtn"
        type="button"
        class="w-full bg-brand-orange hover:bg-brand-darkorange active:bg-brand-darkorange text-white font-bold py-2.5 sm:py-3 rounded-xl text-xs uppercase tracking-wider font-mono transition cursor-pointer shadow-lg shadow-brand-orange/20"
      >
        Einstellungen Speichern
      </button>

      <button
        id="resetCounterBtn"
        type="button"
        class="w-full bg-red-950/60 hover:bg-red-900 border border-red-800/60 text-red-300 hover:text-white font-semibold py-2 rounded-xl text-xs uppercase tracking-wider font-mono transition cursor-pointer"
      >
        Zähler auf 0 Zurücksetzen
      </button>
    </div>
  </div>
</div>
