---
// Footer Component
---

<footer class="w-full max-w-md mx-auto px-1 mt-auto pt-2 shrink-0">
  <div class="bg-brand-surface/80 border border-brand-surfaceBorder rounded-2xl p-2 sm:p-2.5 flex items-center gap-1.5 sm:gap-2 shadow-2xl backdrop-blur-md">
    <!-- Native Share & Send Button (Primary Trigger for iOS/Android Native Share Sheet) -->
    <button
      id="shareReportBtn"
      type="button"
      class="tap-btn flex-1 bg-white hover:bg-brand-cream active:bg-zinc-200 text-black font-bold py-2.5 xs:py-3 sm:py-3.5 px-3 rounded-xl flex items-center justify-center gap-1.5 shadow-lg transition cursor-pointer select-none min-w-0"
    >
      <svg class="w-4 h-4 text-brand-darkorange shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
      </svg>
      <span class="text-xs uppercase tracking-wider font-display font-black truncate">
        Teilen / Senden
      </span>
    </button>

    <!-- Direct Mailto Button -->
    <button
      id="sendMailBtn"
      type="button"
      title="Direkt per E-Mail (mailto:) senden"
      aria-label="Direkt per E-Mail (mailto:) senden"
      class="tap-btn bg-zinc-800 hover:bg-zinc-700 active:bg-zinc-600 text-brand-amber hover:text-white p-2.5 xs:p-3 sm:p-3.5 rounded-xl flex items-center justify-center transition cursor-pointer shrink-0 border border-zinc-700/60"
    >
      <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="currentColor" viewBox="0 0 20 20">
        <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
        <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
      </svg>
    </button>

    <!-- Settings / Options Button -->
    <button
      id="optionsBtn"
      type="button"
      title="Einstellungen & Station"
      aria-label="Einstellungen & Station öffnen"
      class="tap-btn bg-zinc-800 hover:bg-zinc-700 active:bg-zinc-600 text-zinc-300 hover:text-white p-2.5 xs:p-3 sm:p-3.5 rounded-xl flex items-center justify-center transition cursor-pointer shrink-0 border border-zinc-700/60"
    >
      <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
    </button>
  </div>

  <!-- Offline & Safety Notice Info Bar -->
  <div class="flex items-center justify-between text-[10px] text-zinc-500 font-mono mt-1.5 sm:mt-2 px-1">
    <span class="flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      Offline &amp; LocalStorage
    </span>
    <span class="text-zinc-400 font-semibold tracking-wider">
      10 € AT THE DOOR
    </span>
  </div>
</footer>
