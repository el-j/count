---
// InstallBanner.astro - Proactive PWA Install Prompt for iOS, Android & Desktop
---

<div
  id="installBanner"
  class="fixed top-2 sm:top-3 left-1/2 -translate-x-1/2 w-[95%] max-w-md bg-brand-surface/95 border border-brand-orange/60 rounded-2xl p-3 sm:p-3.5 shadow-2xl backdrop-blur-xl z-50 hidden transition-all duration-300 animate-in fade-in slide-in-from-top-4"
  role="alert"
  aria-live="polite"
>
  <div class="flex items-start gap-3">
    <!-- App Logo Thumbnail -->
    <div class="w-10 h-10 rounded-xl bg-black border border-brand-surfaceBorder flex items-center justify-center shrink-0 shadow-md">
      <svg class="w-6 h-6 text-brand-orange" viewBox="0 0 128 128" fill="none">
        <rect width="128" height="128" rx="28" fill="#0b090a" />
        <circle cx="64" cy="64" r="44" stroke="#ff4d15" stroke-width="6" fill="none" opacity="0.6"/>
        <path d="M64 38 V90 M38 64 H90" stroke="#f4ede2" stroke-width="8" stroke-linecap="round" />
      </svg>
    </div>

    <!-- Text info -->
    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between">
        <h3 class="text-xs sm:text-sm font-display uppercase tracking-wide text-white font-bold">
          App Installieren <span class="text-brand-amber font-mono text-[10px] lowercase">(offline)</span>
        </h3>
        <button
          id="dismissInstallBtn"
          type="button"
          aria-label="Installations-Hinweis schließen"
          class="text-zinc-400 hover:text-white p-0.5 rounded text-lg leading-none transition cursor-pointer"
        >
          &times;
        </button>
      </div>

      <p id="installDescription" class="text-[11px] text-zinc-300 mt-0.5 leading-tight">
        Für 100% Offline-Betrieb &amp; Vollbild an der Tür zum Startbildschirm hinzufügen.
      </p>

      <!-- Dynamic Action Area -->
      <div class="mt-2.5 flex items-center gap-2">
        <!-- Native Install Button (Chrome / Android / Desktop) -->
        <button
          id="triggerInstallBtn"
          type="button"
          class="tap-btn bg-brand-orange hover:bg-brand-darkorange active:bg-brand-darkorange text-white text-xs font-bold py-1.5 px-3.5 rounded-xl uppercase tracking-wider font-mono transition shadow-md cursor-pointer shrink-0 hidden"
        >
          Installieren
        </button>

        <!-- iOS Instructions Tooltip -->
        <div id="iosInstallGuide" class="text-[10px] text-amber-200 bg-amber-950/50 border border-amber-800/60 rounded-xl px-2.5 py-1.5 font-mono leading-tight hidden flex-1">
          Tippe auf <span class="text-white font-bold">Teilen (⎋)</span> &amp; wähle <span class="text-white font-bold">„Zum Home-Bildschirm“ (+)</span>.
        </div>

        <button
          id="laterInstallBtn"
          type="button"
          class="text-zinc-400 hover:text-zinc-200 text-[11px] font-mono px-2 py-1 transition cursor-pointer"
        >
          Später
        </button>
      </div>
    </div>
  </div>
</div>
