---
// Log History Modal Component
---

<div
  id="logModal"
  class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 hidden transition-opacity"
  role="dialog"
  aria-modal="true"
  aria-labelledby="logModalTitle"
>
  <div class="bg-brand-surface border border-brand-surfaceBorder w-full max-w-md rounded-t-3xl sm:rounded-2xl max-h-[82vh] flex flex-col p-5 shadow-2xl animate-in slide-in-from-bottom duration-200">
    <div class="flex justify-between items-center pb-3 border-b border-zinc-800">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-brand-orange"></span>
        <h2 id="logModalTitle" class="font-display uppercase text-lg text-white font-bold tracking-wide">
          Einlass-Verlauf
        </h2>
      </div>
      <button
        id="closeLogBtn"
        type="button"
        aria-label="Verlauf schließen"
        class="text-zinc-400 hover:text-white p-1 rounded-lg text-xl leading-none transition cursor-pointer"
      >
        &times;
      </button>
    </div>

    <!-- Scrollable Entries Container -->
    <div id="logListContainer" class="overflow-y-auto flex-1 my-3 space-y-2 pr-1 min-h-[160px] max-h-[50vh]">
      <!-- Populated dynamically via counter.ts -->
    </div>

    <button
      id="closeLogModalBottomBtn"
      type="button"
      class="w-full bg-zinc-800 hover:bg-zinc-700 active:bg-zinc-600 text-white font-semibold py-3 rounded-xl text-xs uppercase tracking-wider font-mono cursor-pointer transition shadow-md"
    >
      Schließen
    </button>
  </div>
</div>
