---
interface Props {
  initialTarget?: number;
  initialCount?: number;
}

const { initialTarget = 300, initialCount = 0 } = Astro.props;
---

<div class="bg-brand-surface/90 border border-brand-surfaceBorder rounded-2xl p-3 sm:p-4 shadow-2xl backdrop-blur-md mb-2 sm:mb-3 relative overflow-hidden shrink-0">
  <!-- Subtle ambient glow background inside card -->
  <div class="absolute -top-10 -right-10 w-28 h-28 bg-brand-orange/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-10 -left-10 w-28 h-28 bg-brand-darkorange/15 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Header row with target and remaining -->
  <div class="flex justify-between items-center text-xs font-mono mb-2 relative z-10">
    <span class="text-zinc-400 uppercase tracking-wider flex items-center gap-1.5 font-medium text-[11px] sm:text-xs">
      <svg class="w-3.5 h-3.5 text-brand-orange shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z" />
      </svg>
      Ziel: <strong class="text-white font-bold ml-0.5">{initialTarget}</strong>
    </span>
    <span id="targetStatusText" class="text-brand-amber font-bold tracking-tight text-[11px] sm:text-xs">
      Noch {initialTarget - initialCount} bis Ziel
    </span>
  </div>

  <!-- Target Progress Bar -->
  <div class="w-full bg-black/70 rounded-full h-2.5 sm:h-3 p-0.5 border border-zinc-800/90 relative overflow-hidden z-10 shadow-inner">
    <div
      id="progressBar"
      class="bg-gradient-to-r from-brand-orange via-brand-amber to-emerald-400 h-full rounded-full transition-all duration-300 shadow-md"
      style="width: 0%"
    ></div>
  </div>

  <!-- Main Hero Count Display -->
  <div class="text-center py-2.5 xs:py-3.5 sm:py-5 relative z-10">
    <div
      id="counterVal"
      class="text-6xl xs:text-7xl sm:text-8xl font-display font-extrabold tracking-tight text-white counter-display tabular-nums leading-none select-none"
    >
      {initialCount}
    </div>
    <p class="text-[10px] sm:text-xs uppercase tracking-widest text-zinc-400 font-semibold mt-1.5 font-mono">
      Gäste Eingelassen (Door Count)
    </p>
  </div>

  <!-- Quick Feedback Line -->
  <div
    id="lastActionToast"
    class="text-[10px] sm:text-[11px] font-mono text-center text-zinc-400 h-3.5 sm:h-4 transition-opacity duration-300 relative z-10 truncate px-2"
  >
    Bereit zum Zählen
  </div>
</div>
