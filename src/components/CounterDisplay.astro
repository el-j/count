---
interface Props {
  initialTarget?: number;
  initialCount?: number;
}

const { initialTarget = 300, initialCount = 0 } = Astro.props;
---

<div class="bg-brand-surface/90 border border-brand-surfaceBorder rounded-2xl p-4 sm:p-5 shadow-2xl backdrop-blur-md mb-3.5 relative overflow-hidden">
  <!-- Subtle ambient glow background inside card -->
  <div class="absolute -top-12 -right-12 w-36 h-36 bg-brand-orange/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-12 -left-12 w-36 h-36 bg-brand-darkorange/15 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Header row with target and remaining -->
  <div class="flex justify-between items-center text-xs font-mono mb-2.5 relative z-10">
    <span class="text-zinc-400 uppercase tracking-wider flex items-center gap-1.5 font-medium">
      <svg class="w-3.5 h-3.5 text-brand-orange" fill="currentColor" viewBox="0 0 20 20">
        <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z" />
      </svg>
      Mindestziel: <strong class="text-white font-bold ml-1">{initialTarget}</strong>
    </span>
    <span id="targetStatusText" class="text-brand-amber font-bold tracking-tight">
      Noch {initialTarget - initialCount} bis Ziel
    </span>
  </div>

  <!-- Target Progress Bar -->
  <div class="w-full bg-black/70 rounded-full h-3.5 p-0.5 border border-zinc-800/90 relative overflow-hidden z-10 shadow-inner">
    <div
      id="progressBar"
      class="bg-gradient-to-r from-brand-orange via-brand-amber to-emerald-400 h-full rounded-full transition-all duration-300 shadow-md"
      style="width: 0%"
    ></div>
  </div>

  <!-- Main Hero Count Display -->
  <div class="text-center py-5 sm:py-6 relative z-10">
    <div
      id="counterVal"
      class="text-7xl sm:text-8xl font-display font-extrabold tracking-tight text-white counter-display tabular-nums leading-none select-none"
    >
      {initialCount}
    </div>
    <p class="text-xs uppercase tracking-widest text-zinc-400 font-semibold mt-2 font-mono">
      Gäste Eingelassen (Door Count)
    </p>
  </div>

  <!-- Quick Feedback Line -->
  <div
    id="lastActionToast"
    class="text-[11px] font-mono text-center text-zinc-400 h-4 transition-opacity duration-300 relative z-10 truncate px-2"
  >
    Bereit zum Zählen
  </div>
</div>
