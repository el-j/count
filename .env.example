# Remote MySQL / MariaDB config for the sync API
COUNTER_DB_HOST=your-db-host.example.com
COUNTER_DB_PORT=3306
COUNTER_DB_NAME=counter_db
COUNTER_DB_USER=counter_user
COUNTER_DB_PASSWORD=replace-with-your-password

# Optional: Astro runtime base path when hosted under a subdirectory
# ASTRO_BASE=/count
